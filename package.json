{
  "name": "sportlog",
  "version": "1.0.0",
  "description": "SportLog — SRM Student Achievement Portal",
  "main": "src/server.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node scripts/seed.js",
    "reset-db": "node scripts/reset-db.js",
    "lint": "eslint src/",
    "test": "node --test test/*.test.js",
    "check": "node --check src/server.js && node --check src/db.js && node --check src/middleware/auth.js && node --check src/routes/auth.js && node --check src/routes/achievements.js && node --check src/routes/stats.js && node --check src/routes/health.js && node --check public/js/app.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.7.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
